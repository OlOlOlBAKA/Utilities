local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local Players = game:GetService("Players")

local function getJobIdSeed()
    local jobId = game.JobId
    if not jobId or jobId == "" then 
        jobId = "HARDCORE_TEST_SEED_123"
    end
    
    local seed = 0
    for i = 1, #jobId do
        seed = seed + string.byte(jobId, i)
    end
    return seed
end

local MASTER_SEED = getJobIdSeed()

local function handleHardcoreRoom(roomNumber)
    math.randomseed(MASTER_SEED + roomNumber)
    
    local spawnRoll = math.random(1, 100)
    local entityTypeRoll = math.random(1, 100)
    
    if roomNumber > 2 and spawnRoll <= 50 then
        local entityName = ""
        local warningText = ""
        
        if entityTypeRoll <= 40 then
            entityName = "A-60"
            warningText = "Extreme speed! Hide in a closet immediately!"
        elseif entityTypeRoll <= 75 then
            entityName = "Depth"
            warningText = "Sub-level entity detected! Stay quiet."
        else
            entityName = "Silence"
            warningText = "Do not move or open doors!"
        end
        
        print(string.format("[HARDCORE SYNC] Room %d: Spawning %s (Seed: %d)", roomNumber, entityName, MASTER_SEED + roomNumber))
        
        StarterGui:SetCore("SendNotification", {
            Title = string.format("⚠️ ROOM %d: %s", roomNumber, entityName),
            Text = warningText,
            Duration = 5
        })
    else
        print(string.format("[HARDCORE SYNC] Room %d is safe.", roomNumber))
    end
end

local gameData = ReplicatedStorage:WaitForChild("GameData", 10)

if gameData and gameData:FindFirstChild("LatestRoom") then
    local latestRoom = gameData.LatestRoom
    
    latestRoom.Changed:Connect(function(newRoomNumber)
        handleHardcoreRoom(newRoomNumber)
    end)
    
    StarterGui:SetCore("SendNotification", {
        Title = "Hardcore Mode Loaded",
        Text = "Synced with party! Good luck.",
        Duration = 4
    })
    
    if latestRoom.Value > 0 then
        handleHardcoreRoom(latestRoom.Value)
    end
end
