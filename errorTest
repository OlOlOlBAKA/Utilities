-- =============================================================================
-- FIXED FETCH: Safe PathfindingMovement loading with precise execution tracking
-- =============================================================================
local PathfindingMovement = nil

local rawCodeSuccess, rawCodeOrErr = pcall(function()
	return game:HttpGet("https://raw.githubusercontent.com/OlOlOlBAKA/Utilities/refs/heads/main/TestTestTest")
end)

if not rawCodeSuccess then
	warn("[PathfindingMovement Network Error]: Failed to download source ->", rawCodeOrErr)
	return
end

-- 1. Check for Compilation / Syntax Errors
local compiledFunction, syntaxError = loadstring(rawCodeOrErr)
if not compiledFunction then
	warn("[PathfindingMovement Syntax Error]: The downloaded code has syntax issues ->", syntaxError)
	return
end

-- 2. Check for Runtime/Execution Errors during initialization
local runSuccess, runError = pcall(function()
	PathfindingMovement = compiledFunction()
end)

if not runSuccess then
	warn("[PathfindingMovement Initialization Error]: The script ran but crashed immediately ->", runError)
	return
elseif type(PathfindingMovement) ~= "table" then
	warn("[PathfindingMovement Content Error]: The script executed successfully, but did not return a valid module table! It returned type:", type(PathfindingMovement))
	return
end

