-- Custom Image Loader
local function customImage(name, link)
	if isfile(name .. ".PNG") then
		delfile(name .. ".PNG")
	end
	writefile(name .. ".PNG", game:HttpGet(link))

	if getcustomasset then
		task.delay(20, function()
			delfile(name .. ".PNG")
		end)
		return getcustomasset(name .. ".PNG")
	end
end

